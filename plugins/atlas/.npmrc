@ohdsi:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# webr pulls react-data-grid@7, whose peer range is react ^19.2, while the Atlas
# plugin itself is on react 18. npm 10 crashes outright while trying to reconcile
# that ("Cannot read properties of null (reading 'edgesOut')") and takes every CI
# job that installs this package down with it. The conflict is in a transitive
# peer only - the resolved tree is unchanged - so skip peer reconciliation here.
legacy-peer-deps=true
