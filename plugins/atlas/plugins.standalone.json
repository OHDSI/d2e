  "settings": {
    "enableHotReload": false,
    "loadTimeout": 30000,
    "showLoadingIndicators": true,
    "theme": {
      "enableDarkMode": false,
      "primaryColor": "#000080",
      "logoUrl": "/atlas/config/d2e2.svg",
      "logoNavigateTo": "/",
      "accentColor": "#ff5e59",
      "landingLogoUrl": "/atlas/config/landing-page-illustration.svg",
      "chartColors": [
        "#000080",
        "#ff5e59",
        "#4e79a7",
        "#76b7b2",
        "#59a14f",
        "#edc949",
        "#af7aa1",
        "#9c755f",
        "#bab0ab",
        "#e15759"
      ],
      "treemapGradient": [
        "#c3cce8",
        "#4a5fb0",
        "#000080"
      ]
    },
    "header": {
      "showNavBar": true,
      "showFeedbackButton": false,
      "showLanguageSelector": true,
      "showConfigButton": true,
      "showUserMenu": true
    }
  }
}