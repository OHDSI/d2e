  "trex": {
    "flow": {
      "image": "ghcr.io/ohdsi/d2e/flow-eq5d5l-index-calculation",
      "flows": [
        {
          "name": "eq5d5l_index_calculation_plugin",
          "entrypoint": "flows.eq5d5l_index_calculation_plugin.flow.eq5d5l_index_calculation_plugin",
          "parameter_openapi_schema": {
            "title": "Parameters",
            "type": "object",
            "properties": {
              "options": {
                "$ref": "#/definitions/Eq5d5lPluginType",
                "position": 0,
                "title": "options"
              }
            },
            "required": [
              "options"
            ],
            "definitions": {
              "Eq5d5lCalculateConfig": {
                "properties": {
                  "dry_run": {
                    "default": false,
                    "title": "Dry Run",
                    "type": "boolean"
                  },
                  "database_code": {
                    "title": "Database Code",
                    "type": "string"
                  },
                  "schema_name": {
                    "title": "Schema Name",
                    "type": "string"
                  },
                  "omop_dataset_id": {
                    "title": "OMOP Dataset Id",
                    "type": "string"
                  },
                  "country_code": {
                    "title": "Country Code",
                    "type": "string",
                    "enum": ["AU", "BE", "CA", "CN", "DE", "DK", "EG", "ET", "FR", "GH"]
                  }
                },
                "required": [
                  "database_code",
                  "schema_name",
                  "omop_dataset_id",
                  "country_code"
                ],
                "title": "Eq5d5lCalculateConfig",
                "type": "object"
              },
              "Eq5d5lPluginType": {
                "properties": {
                  "config": {
                    "$ref": "#/definitions/Eq5d5lCalculateConfig",
                    "title": "Config"
                  }
                },
                "required": [
                  "config"
                ],
                "title": "Eq5d5lPluginType",
                "type": "object"
              }
            }
          },
          "type": "eq5d5l",
          "command": "/app/run-flow.sh eq5d5l-index-calculation-flow"
        }
      ]
    }
  }
