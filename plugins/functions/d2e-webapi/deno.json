{
  "workspace": [],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": true
  },
  "tasks": {
    "dev": "SERVICE_ROUTES='{}' deno run --watch --allow-env --allow-read --allow-write --allow-net --allow-sys index.ts",
    "check": "deno check ./index.ts && deno lint"
  },
  "imports": {
    "@fastify/swagger": "npm:@fastify/swagger@^9.4.2",
    "@fastify/swagger-ui": "npm:@fastify/swagger-ui@^5.2.1",
    "@std/assert": "jsr:@std/assert@1",
    "fastify": "npm:fastify@^5.2.1",
    "fastify-type-provider-zod": "npm:fastify-type-provider-zod@^4.0.2",
    "zod": "npm:zod@3.25.76"
  }
}
