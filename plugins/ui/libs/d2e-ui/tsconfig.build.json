{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "node_modules",
    "explorer",
    "src/**/__tests__/**",
    "src/**/*.story.vue",
    "src/_story/**"
  ]
}
