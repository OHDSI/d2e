# syntax=docker/dockerfile:1.4
#
# d2e-trex: trexsql base with WebAPI running in-engine via webapi.trex
# (started by core/server with SELECT webapi_start()), not as a separate Java
# process. The base image already ships trex's canonical main/event core with the
# env-gated D2E_COMPAT layer (merged upstream), so the core is NOT vendored here —
# this image only adds d2e's plugins, CDW data and logto.
#
# Two variants come off this file, differing only in the base TREXSQL_REF:
#   default (below)      trexsql's lean `prod` target -> d2e-trex:<tag>, what
#                        docker-compose.yml runs
#   the full base's ref  trexsql's `full` target      -> d2e-trex:<tag>-devx,
#                        what docker-compose-local.yml runs (it passes the ref
#                        as a build arg; CI does the same for the -devx tag)
# The full base adds ~1.2GB compressed of dev tooling (playwright + chromium,
# the Claude Code CLI, gh, bun/uv/prefect and the devx payload) that a deployed
# stack never runs; TREX_DX_ENABLED only gates it at runtime, it is in the image
# either way. Pinned by tag AND index digest — `image:tag@digest` is valid, so
# one arg carries both.
ARG TREXSQL_REF=prod-sha-84949e26abb989445f8f02c5cb80628eb7f3f2ce@sha256:a46811a17bfb4c0b4775eb1e710deec2a42c984495195b126b943f24cd7fe42c
FROM ghcr.io/ohdsi/trexsql:${TREXSQL_REF} AS base

USER root
WORKDIR /usr/src

# Selects the arch-correct DuckDB extension directory (amd64/arm64).
ARG TARGETARCH

ENV DUCKDB_VERSION=1.4.4

# Deps not in the slim node base (node/npm/tar/unzip already present).
# jq reads each bundled tarball's package.json, python3 runs the two-pass
# extract. wget went with the ONNX and ADBC installs the base now owns.
RUN apt-get update && apt-get install -y --no-install-recommends \
    jq python3 \
    && rm -rf /var/lib/apt/lists/*

# NOTE: DuckDB extensions are NOT downloaded here. The base image owns that set
# (see the trexsql Dockerfile's DUCKDB_*_EXTENSIONS) and installs it into
# /usr/share/trexsql/extensions; the seeding step further down puts it on the
# per-user lookup paths. Re-fetching duplicated the binaries, and for bigquery it
# actively regressed the image: the community build lacks the DuckDB 1.4
# write-path backport, which is why the base compiles its own from source.
#
# To add an extension, add it to the base image rather than fetching it here.

# NOTE: no snowflake ADBC driver install here either. The base ships both the
# `snowflake` extension and the libadbc_driver_snowflake.so it dlopen()s at
# ATTACH time, with the Apache-2.0 notices beside it.

RUN mkdir -p /usr/src/data/cache /usr/src/data/plugins /usr/src/data/flow_staging /usr/src/cdw_data/built_in ./cert /var/log/d2e/audit \
 && chmod 1777 /usr/src/data/flow_staging

# Bundle CI-built plugins from plugin-artifacts/*.tgz. Two-pass extract handles
# cross-directory hardlinks in Deno-packed tarballs that GNU tar -x rejects.
COPY scripts/extract-plugin-tarball.py /scripts/
RUN mkdir -p /usr/src/bundled-plugins
# Bind-mounted, not COPY'd: the tarballs are a build input consumed by this RUN
# and the `rm -rf` that used to follow ran a layer too late to reclaim them, so
# the image carried ~830MB of .tgz it never reads again. plugin-artifacts/ is
# always in the context (.gitkeep) — empty for local builds, which take the
# registry path below instead.
RUN --mount=type=bind,source=plugin-artifacts,target=/tmp/plugin-artifacts \
    set -eu; \
    if ls /tmp/plugin-artifacts/*.tgz >/dev/null 2>&1; then \
      for TGZ in /tmp/plugin-artifacts/*.tgz; do \
        NAME="$(tar -xzOf "$TGZ" package/package.json | jq -r .name)"; \
        SHORT="$(printf '%s' "$NAME" | sed 's|@[^/]*/||')"; \
        DEST="/usr/src/bundled-plugins/$SHORT"; \
        rm -rf "$DEST"; \
        mkdir -p "$DEST"; \
        python3 /scripts/extract-plugin-tarball.py "$TGZ" "$DEST" 1; \
      done; \
    fi

# PLUGINS_REGISTRY (BuildKit secret) overrides the feed when present.
COPY scripts/fetch-external-plugins.sh /scripts/
COPY external-plugins.txt /scripts/
ARG PLUGINS_FEED=d2e
# @data2evidence/* packages to pull from the feed. Empty in CI (uses
# plugin-artifacts/); local builds set it via docker-compose-local.yml.
ARG PLUGINS_FROM_REGISTRY=""
RUN --mount=type=secret,id=PLUGINS_REGISTRY --mount=type=secret,id=github_token set -eu; \
    REG="https://pkgs.dev.azure.com/data2evidence/d2e/_packaging/${PLUGINS_FEED}/npm/registry/"; \
    if [ -f /run/secrets/PLUGINS_REGISTRY ]; then \
      SECRET_REG="$(cat /run/secrets/PLUGINS_REGISTRY)"; \
      if [ -n "$SECRET_REG" ]; then \
        REG="$SECRET_REG"; \
      fi; \
    fi; \
    # Keep npm auth (incl. the @ohdsi GitHub Packages token) in a throwaway
    # userconfig that is deleted when this layer's shell exits, so it is never
    # written to a persistent .npmrc baked into the image.
    NPMRC="$(mktemp)"; export NPM_CONFIG_USERCONFIG="$NPMRC"; \
    trap 'rm -f "$NPMRC"' EXIT; \
    npm config set @data2evidence:registry "$REG"; \
    if [ -s /run/secrets/github_token ]; then \
      npm config set @ohdsi:registry "https://npm.pkg.github.com"; \
      npm config set //npm.pkg.github.com/:_authToken "$(cat /run/secrets/github_token)"; \
    fi; \
    sh /scripts/fetch-external-plugins.sh /scripts/external-plugins.txt /usr/src/bundled-plugins; \
    if [ -n "$PLUGINS_FROM_REGISTRY" ]; then \
      printf '%s' "$PLUGINS_FROM_REGISTRY" | tr ', ' '\n\n' > /tmp/registry-plugins.txt; \
      sh /scripts/fetch-external-plugins.sh /tmp/registry-plugins.txt /usr/src/bundled-plugins; \
      rm -f /tmp/registry-plugins.txt; \
    fi
# d2e's boot-time database provisioning, run by trex's `trex.provision` plugin
# kind before any other plugin loads. Baked rather than bind-mounted because
# trex aborts boot when POSTGRES_MANAGE_CONFIG is set and no provision plugin is
# found — a compose-only mount would take down every other deploy path.
COPY provision/d2e-bootstrap /usr/src/bundled-plugins/d2e-bootstrap

# The notebook schema's migrations, run by trex's `trex.migrations` plugin kind.
# Baked for the same reason as the bootstrap above: PG_SCHEMA creates the empty
# `notebook` schema on every deploy path, but only compose bind-mounts this
# plugin, so a Helm install got the schema with none of its tables and every
# notebook GraphQL operation failed.
COPY migrations/notebook /usr/src/bundled-plugins/notebook-schema

# NOTE: The legacy @data2evidence/d2e-atlas ("Atlas Lite") is no longer bundled.
# Atlas3 (@ohdsi/atlas3) is shipped by the local plugins/atlas plugin, which owns
# the /atlas route. Re-adding a d2e-atlas bundle here would reclaim /atlas (it
# declares source:/atlas) and shadow Atlas3.

ENV PLUGINS_DEV_PATH=/usr/src/bundled-plugins:/usr/src/plugins

# NOTE: the core (main + event, with D2E_COMPAT) is NOT vendored — it is provided
# by the base trexsql image at /usr/src/core (index.eszip already bundled there).

RUN mkdir -p ./logto
COPY ./logto ./logto
COPY ./cdw_data/built_in /usr/src/cdw_data/built_in

# Point DuckDB's default per-user extension path at the base image's extension
# directory so trex's main `LOAD <ext>` (icu/fts) resolves — the base installs
# to DUCKDB_EXTENSION_DIRECTORY (/usr/share/trexsql/extensions) but worker
# connections look in ~/.duckdb. This image runs as root, so /root/.duckdb.
#
# A symlink, not a copy: `cp -r` duplicated the base's whole extension set into
# /root/.duckdb, 745MB of second copies (17 extensions, spatial and bigquery
# alone 158MB) that DuckDB resolves identically through a link. The base
# already links /home/node's per-arch path at this same target.
RUN set -eu; \
    EXT_SRC="/usr/share/trexsql/extensions/v${DUCKDB_VERSION}/linux_${TARGETARCH}"; \
    test -d "$EXT_SRC" || { echo "FATAL: base image has no $EXT_SRC" >&2; exit 1; }; \
    for HOME_DIR in /root /home/node; do \
      DEST="$HOME_DIR/.duckdb/extensions/v${DUCKDB_VERSION}/linux_${TARGETARCH}"; \
      mkdir -p "$(dirname "$DEST")"; \
      # rm -rf, not just `ln -sfn`: -f replaces a file or a symlink, but against
      # a real directory ln silently creates the link *inside* it instead, which
      # would leave a stale copy behind and break the assertions below.
      rm -rf "$DEST"; \
      ln -sfn "$EXT_SRC" "$DEST"; \
    done; \
    chown node:node /home/node/.duckdb /home/node/.duckdb/extensions \
      "/home/node/.duckdb/extensions/v${DUCKDB_VERSION}"; \
    chown -h node:node "/home/node/.duckdb/extensions/v${DUCKDB_VERSION}/linux_${TARGETARCH}"; \
    # These extensions come only from the base image, so a broken link would
    # otherwise surface much later as a LOAD error at runtime.
    for lib in bigquery icu fts; do \
      test -s "/root/.duckdb/extensions/v${DUCKDB_VERSION}/linux_${TARGETARCH}/${lib}.duckdb_extension" \
        || { echo "FATAL: ${lib} missing from /root/.duckdb after seeding from the base image" >&2; exit 1; }; \
    done

# WebAPI, trexas HTTP/TLS, pgwire, gossip, FHIR.
EXPOSE 8080 33001 33000 5433 5432 4200 8094

# Write the internal TLS cert from env, then run the engine. ENTRYPOINT is
# cleared because the base one gates on TREX_ROOT_KEY, which d2e doesn't use.
ENTRYPOINT []
CMD ["sh", "-c", "mkdir -p /usr/src/cert && printf '%s' \"$TLS__INTERNAL__CRT\" > /usr/src/cert/cert.pem && printf '%s' \"$TLS__INTERNAL__KEY\" > /usr/src/cert/key.pem && exec trex ${TREX_OTEL_ENABLED:+--enable-otel}"]
